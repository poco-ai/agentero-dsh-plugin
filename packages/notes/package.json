{
  "name": "agentero-dsh-notes",
  "version": "0.1.8",
  "description": "Agentero notes panel for DeepSeek Harness",
  "homepage": "https://github.com/poco-ai/Agentero",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "dependencies": {
    "@platejs/basic-nodes": "53.0.0",
    "@platejs/code-block": "53.0.0",
    "@platejs/find-replace": "53.0.0",
    "@platejs/indent": "53.0.0",
    "@platejs/link": "53.3.5",
    "@platejs/list": "53.1.3",
    "@platejs/markdown": "53.2.2",
    "@platejs/math": "53.0.0",
    "@platejs/table": "53.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.18.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.554.0",
    "platejs": "53.3.14",
    "radix-ui": "^1.4.3",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.3.1"
  }
}
